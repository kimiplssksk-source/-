    </div>

    <script>
        // ==================== STATE ====================
        let settings = {
            text: 'เล็ก',
            autoFit: true,
            minFontSize: 40,
            fontSize: 20,
            fontWeight: 900,
            fontFamily: "'Kanit', sans-serif",
            textColor: '#ffffff',
            bgColor: '#1a1a2e',
            accentColor: '#e94560',
            bgOpacity: 100,
            effect: 'none',
            animation: 'none',
            background: 'solid',
            alignH: 'center',
            alignV: 'center',
            lineHeight: 1.1,
            letterSpacing: 0,
            rotate: false,
            rotateDeg: 0,
            textOpacity: 100,
            marquee: false,
            marqueeSpeed: 10, 
            marqueeDir: 'rtl'  
        };

        const mainText = document.getElementById('mainText');
        const rotationWrapper = document.getElementById('rotationWrapper');
        const marqueeTrack = document.getElementById('marqueeTrack');
        const displayContainer = document.getElementById('displayContainer');
        const settingsPanel = document.getElementById('settingsPanel');
        const progressOverlay = document.getElementById('progressOverlay');
        const progressBarFill = document.getElementById('progressBarFill');
        const progressText = document.getElementById('progressText');
        const progressPercent = document.getElementById('progressPercent');
        const progressDetail = document.getElementById('progressDetail');
        const gifBtn = document.getElementById('gifBtn');
        const toast = document.getElementById('toast');

        // ==================== TOAST ====================
        function showToast(msg) {
            toast.textContent = msg;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 2000);
        }

        // ==================== COLLAPSE SYSTEM ====================
        let isPresetsCollapsed = false;
        function togglePresets() {
            const content = document.getElementById('presetsContent');
            const btnText = document.getElementById('presetsCollapseBtn');
            
            isPresetsCollapsed = !isPresetsCollapsed;
            if (isPresetsCollapsed) {
                content.classList.add('collapsed');
                btnText.innerHTML = 'ขยาย <span id="presetsArrow">▼</span>';
            } else {
                content.classList.remove('collapsed');
                btnText.innerHTML = 'ซ่อน <span id="presetsArrow">▲</span>';
            }
        }

        // ==================== UTILITY ====================
        function hideUI() {
            document.getElementById('settingsToggle').style.display = 'none';
            settingsPanel.classList.remove('open');
        }

        function showUI() {
            document.getElementById('settingsToggle').style.display = 'flex';
        }

        function setProgress(percent, text, detail) {
            progressBarFill.style.width = percent + '%';
            progressPercent.textContent = Math.round(percent) + '%';
            if (text) progressText.textContent = text;
            if (detail) progressDetail.textContent = detail;
        }

        // ==================== AUTO FIT ALGORITHM ====================
        function adjustFontSize() {
            if (!settings.autoFit) {
                mainText.style.fontSize = settings.fontSize + 'vw';
                displayContainer.style.justifyContent = settings.alignH === 'left' ? 'flex-start' : (settings.alignH === 'right' ? 'flex-end' : 'center');
                return;
            }

            const prevTransform = rotationWrapper.style.transform;
            rotationWrapper.style.transform = 'none';

            const maxW = displayContainer.clientWidth - 80; 
            const maxH = displayContainer.clientHeight - 80;

            if (settings.marquee) {
                let minSize = 20; 
                let maxSize = displayContainer.clientHeight * 0.85; 
                let optimalSize = minSize;

                for (let i = 0; i < 15; i++) {
                    let midSize = (minSize + maxSize) / 2;
                    mainText.style.fontSize = midSize + 'px';

                    if (mainText.offsetHeight <= maxH) {
                        optimalSize = midSize;
                        minSize = midSize + 0.5;
                    } else {
                        maxSize = midSize - 0.5;
                    }
                }

                mainText.style.fontSize = optimalSize + 'px';
                rotationWrapper.style.transform = prevTransform;
                displayContainer.style.justifyContent = 'flex-start';
                return;
            }

            const minReadableSize = settings.minFontSize || 40; 
            let minSize = minReadableSize; 
            let maxSize = 500; 
            let optimalSize = minReadableSize;

            for (let i = 0; i < 20; i++) {
                let midSize = (minSize + maxSize) / 2;
                mainText.style.fontSize = midSize + 'px';

                if (mainText.scrollWidth <= maxW && mainText.scrollHeight <= maxH) {
                    optimalSize = midSize;
                    minSize = midSize + 0.1; 
                } else {
                    maxSize = midSize - 0.1; 
                }
            }

            if (optimalSize < minReadableSize) {
                optimalSize = minReadableSize;
            }

            mainText.style.fontSize = optimalSize + 'px';
            rotationWrapper.style.transform = prevTransform;

            if (mainText.scrollWidth > displayContainer.clientWidth - 80) {
                displayContainer.style.justifyContent = 'flex-start';
            } else {
                displayContainer.style.justifyContent = settings.alignH === 'left' ? 'flex-start' : (settings.alignH === 'right' ? 'flex-end' : 'center');
            }
        }

        window.addEventListener('resize', adjustFontSize);

        function toggleAutoFit() {
            settings.autoFit = document.getElementById('autoFitToggle').checked;
            const manualGroup = document.getElementById('manualFontSizeGroup');
            const minGroup = document.getElementById('minFontSizeGroup');
            if (settings.autoFit) {
                manualGroup.style.display = 'none';
                minGroup.style.display = settings.marquee ? 'none' : 'block';
            } else {
                manualGroup.style.display = 'block';
                minGroup.style.display = 'none';
            }
            adjustFontSize();
        }

        function updateMinFontSize() {
            settings.minFontSize = +document.getElementById('minFontSize').value;
            document.getElementById('minFontSizeValue').textContent = settings.minFontSize + 'px';
            adjustFontSize();
        }

        // ==================== MARQUEE CONTROLS ====================
        function toggleMarquee() {
            settings.marquee = document.getElementById('marqueeToggle').checked;
            
            const speedGroup = document.getElementById('marqueeSpeedGroup');
            const dirGroup = document.getElementById('marqueeDirGroup');
            const minFontSizeGroup = document.getElementById('minFontSizeGroup');

            if (settings.marquee) {
                speedGroup.style.display = 'block';
                dirGroup.style.display = 'block';
                minFontSizeGroup.style.display = 'none'; 
            } else {
                speedGroup.style.display = 'none';
                dirGroup.style.display = 'none';
                if (settings.autoFit) {
                    minFontSizeGroup.style.display = 'block';
                }
            }

            applyMarqueeAnimation();
        }

        function updateMarqueeSpeed() {
            settings.marqueeSpeed = +document.getElementById('marqueeSpeed').value;
            document.getElementById('marqueeSpeedValue').textContent = settings.marqueeSpeed + 's';
            applyMarqueeAnimation();
        }

        function setMarqueeDir(dir) {
            settings.marqueeDir = dir;
            updateActiveButton('dir', dir);
            applyMarqueeAnimation();
        }

        function applyMarqueeAnimation() {
            marqueeTrack.classList.remove('marquee-active-rtl', 'marquee-active-ltr');
            
            if (settings.marquee) {
                marqueeTrack.style.setProperty('--marquee-speed', settings.marqueeSpeed + 's');
                
                if (settings.marqueeDir === 'rtl') {
                    marqueeTrack.classList.add('marquee-active-rtl');
                } else {
                    marqueeTrack.classList.add('marquee-active-ltr');
                }
            } else {
                marqueeTrack.style.transform = '';
            }

            adjustFontSize();
        }

        // ==================== ROTATION CONTROLS ====================
        function toggleRotate() {
            settings.rotate = document.getElementById('rotateToggle').checked;
            updateTransform();
        }

        function updateRotateDeg() {
            settings.rotateDeg = +document.getElementById('rotateDeg').value;
            document.getElementById('rotateDegValue').textContent = settings.rotateDeg + '°';
            updateTransform();
        }

        function updateTransform() {
            if (settings.rotate) {
                rotationWrapper.style.transform = `rotate(${settings.rotateDeg}deg)`;
            } else {
                rotationWrapper.style.transform = 'none';
            }
            adjustFontSize();
        }

        // ==================== DOWNLOAD PNG ====================
        async function downloadImage() {
            hideUI();
            await new Promise(r => setTimeout(r, 300));
            try {
                const canvas = await html2canvas(displayContainer, {
                    backgroundColor: null,
                    scale: 2,
                    useCORS: true,
                    allowTaint: true,
                    logging: false
                });
                const link = document.createElement('a');
                link.download = `text-${settings.text.substring(0, 10)}-${Date.now()}.png`;
                link.href = canvas.toDataURL('image/png');
                link.click();
                showToast('💾 ดาวน์โหลดรูปภาพสำเร็จ!');
            } catch (err) {
                console.error(err);
                alert('เกิดข้อผิดพลาดในการบันทึกรูป');
            } finally {
                showUI();
            }
        }

        // ==================== DOWNLOAD GIF ====================
        async function downloadGIF() {
            const hasAnim = settings.animation !== 'none' || settings.background === 'gradient' || settings.background === 'aurora' || settings.marquee;
            if (!hasAnim) {
                if (!confirm('ไม่มีอนิมิชันเคลื่อนไหวใดๆ ทำงานอยู่ตอนนี้\nต้องการบันทึกเป็นไฟล์ GIF อยู่หรือไม่?')) return;
            }

            hideUI();
            progressOverlay.classList.add('show');
            gifBtn.disabled = true;

            const totalFrames = 25;
            const frameDelay = 100;
            const images = [];

            try {
                for (let i = 0; i < totalFrames; i++) {
                    setProgress((i / totalFrames) * 50, `กำลังจับภาพเฟรม ${i + 1}/${totalFrames}`, 'กรุณาเปิดหน้านี้ทิ้งไว้จนกว่าจะเสร็จสิ้น');
                    await new Promise(r => setTimeout(r, frameDelay));

                    const canvas = await html2canvas(displayContainer, {
                        backgroundColor: null,
                        scale: 1,
                        useCORS: true,
                        allowTaint: true,
                        logging: false
                    });
                    images.push(canvas.toDataURL('image/png'));
                }

                setProgress(60, 'กำลังรวบรวมเฟรมและสร้างไฟล์ GIF...', 'ประมวลผลเอฟเฟกต์แอนิเมชัน');

                gifshot.createGIF({
                    images: images,
                    gifWidth: displayContainer.offsetWidth,
                    gifHeight: displayContainer.offsetHeight,
                    interval: frameDelay / 1000,
                    numFrames: totalFrames,
                    frameDuration: 1,
                    sampleInterval: 10,
                    numWorkers: 2
                }, function(obj) {
                    if (!obj.error && obj.image) {
                        setProgress(100, 'ประมวลผลเสร็จสิ้น!', 'กำลังจัดเตรียมไฟล์ดาวน์โหลด...');
                        const link = document.createElement('a');
                        link.download = `animated-${settings.text.substring(0, 10)}-${Date.now()}.gif`;
                        link.href = obj.image;
                        link.click();
                        setTimeout(() => progressOverlay.classList.remove('show'), 800);
                        showToast('🎬 ดาวน์โหลด GIF สำเร็จ!');
                    } else {
                        console.error('GIF error:', obj.error);
                        alert('สร้าง GIF ไม่สำเร็จ: ' + (obj.error || 'Unknown error'));
                        progressOverlay.classList.remove('show');
                    }
                    gifBtn.disabled = false;
                    showUI();
                });
            } catch (err) {
                console.error(err);
                alert('เกิดข้อผิดพลาดในการสร้าง GIF');
                progressOverlay.classList.remove('show');
                gifBtn.disabled = false;
                showUI();
            }
        }

        // ==================== SETTINGS PANEL ====================
        function toggleSettings() {
            settingsPanel.classList.toggle('open');
        }

        document.addEventListener('click', (e) => {
            if (!settingsPanel.contains(e.target) && !e.target.closest('#settingsToggle')) {
                settingsPanel.classList.remove('open');
            }
        });

        // ==================== TEXT CONTROLS ====================
        function updateText() {
            settings.text = document.getElementById('textInput').value || ' ';
            mainText.textContent = settings.text;
            adjustFontSize();
        }

        function updateFontSize() {
            settings.fontSize = +document.getElementById('fontSize').value;
            document.getElementById('fontSizeValue').textContent = settings.fontSize + 'vw';
            adjustFontSize();
        }

        // ==================== TEXT WEIGHT & FAMILY ====================
        function updateFontWeight() {
            settings.fontWeight = +document.getElementById('fontWeight').value;
            document.getElementById('fontWeightValue').textContent = settings.fontWeight;
            if (settings.effect !== 'outline') {
                mainText.style.fontWeight = settings.fontWeight;
            }
            adjustFontSize();
        }

        function updateFontFamily() {
            settings.fontFamily = document.getElementById('fontFamily').value;
            mainText.style.fontFamily = settings.fontFamily;
            adjustFontSize();
        }

        // ==================== COLOR CONTROLS ====================
        function updateTextColor() {
            settings.textColor = document.getElementById('textColor').value;
            document.getElementById('textColorHex').value = settings.textColor;
            document.documentElement.style.setProperty('--text-color', settings.textColor);
            if (settings.effect !== 'gradient' && settings.effect !== 'metallic') {
                mainText.style.color = settings.textColor;
            }
        }

        function updateTextColorFromHex() {
            const val = document.getElementById('textColorHex').value;
            if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
                document.getElementById('textColor').value = val;
                updateTextColor();
            }
        }

        function updateBgColor() {
            settings.bgColor = document.getElementById('bgColor').value;
            document.getElementById('bgColorHex').value = settings.bgColor;
            applyBackground();
        }

        function updateBgColorFromHex() {
            const val = document.getElementById('bgColorHex').value;
            if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
                document.getElementById('bgColor').value = val;
                updateBgColor();
            }
        }

        function updateAccentColor() {
            settings.accentColor = document.getElementById('accentColor').value;
            document.getElementById('accentColorHex').value = settings.accentColor;
            document.documentElement.style.setProperty('--accent-color', settings.accentColor);
        }

        function updateAccentColorFromHex() {
            const val = document.getElementById('accentColorHex').value;
            if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
                document.getElementById('accentColor').value = val;
                updateAccentColor();
            }
        }

        function updateBgOpacity() {
            settings.bgOpacity = +document.getElementById('bgOpacity').value;
            document.getElementById('bgOpacityValue').textContent = settings.bgOpacity + '%';
            applyBackground();
        }

        function applyBackground() {
            const r = parseInt(settings.bgColor.slice(1, 3), 16);
            const g = parseInt(settings.bgColor.slice(3, 5), 16);
            const b = parseInt(settings.bgColor.slice(5, 7), 16);
            const a = settings.bgOpacity / 100;

            if (['gradient', 'cyberpunk', 'matrix', 'aurora'].includes(settings.background)) {
                displayContainer.style.background = '';
            } else {
                displayContainer.style.background = `rgba(${r},${g},${b},${a})`;
            }
        }

        // ==================== EFFECTS SYSTEM ====================
        function setEffect(effect) {
            mainText.classList.remove(
                'fx-outline', 'fx-shadow', 'fx-glow', 'fx-3d', 'fx-gradient', 'fx-neon',
                'fx-retro', 'fx-fire', 'fx-cyber', 'fx-metallic', 'fx-rainbow-glow'
            );
            settings.effect = effect;

            if (effect === 'outline') {
                mainText.style.fontWeight = '400';
                mainText.style.color = '';
                mainText.style.webkitTextFillColor = '';
                mainText.style.background = '';
            } else if (effect === 'gradient' || effect === 'metallic') {
                mainText.style.fontWeight = settings.fontWeight;
                mainText.style.color = '';
            } else {
                mainText.style.fontWeight = settings.fontWeight;
                mainText.style.color = settings.textColor;
                mainText.style.webkitTextFillColor = '';
                mainText.style.background = '';
            }

            if (effect !== 'none') {
                mainText.classList.add('fx-' + effect);
            }

            updateActiveButton('effect', effect);
            adjustFontSize();
        }

        // ==================== ANIMATIONS SYSTEM ====================
        function setAnimation(anim) {
            mainText.classList.remove(
                'anim-wave', 'anim-pulse', 'anim-rotate', 'anim-bounce', 'anim-shake', 'anim-glitch', 'anim-blink',
                'anim-float', 'anim-swing', 'anim-heartbeat', 'anim-elastic', 'anim-flip'
            );
            settings.animation = anim;

            if (anim !== 'none') {
                mainText.classList.add('anim-' + anim);
            }

            updateActiveButton('anim', anim);
        }

        // ==================== BACKGROUND SYSTEM ====================
        function setBackground(bg) {
            displayContainer.classList.remove(
                'pattern-dots', 'pattern-grid', 'pattern-lines', 'pattern-gradient', 'pattern-cyberpunk', 'pattern-matrix',
                'pattern-aurora', 'pattern-stars', 'pattern-checkerboard', 'pattern-stripes', 'pattern-bokeh'
            );
            settings.background = bg;

            if (bg !== 'solid') {
                displayContainer.classList.add('pattern-' + bg);
            }

            applyBackground();
            updateActiveButton('bg', bg);
        }

        // ==================== ALIGNMENT ====================
        function setAlignH(align) {
            settings.alignH = align;
            mainText.style.textAlign = align;
            updateActiveButton('h', align);
            adjustFontSize();
        }

        function setAlignV(align) {
            settings.alignV = align;
            displayContainer.style.alignItems = align;
            updateActiveButton('v', align.replace('flex-', ''));
        }

        function updateLineHeight() {
            settings.lineHeight = +document.getElementById('lineHeight').value;
            document.getElementById('lineHeightValue').textContent = settings.lineHeight.toFixed(1);
            mainText.style.lineHeight = settings.lineHeight;
            adjustFontSize();
        }

        function updateLetterSpacing() {
            settings.letterSpacing = +document.getElementById('letterSpacing').value;
            document.getElementById('letterSpacingValue').textContent = settings.letterSpacing + 'px';
            mainText.style.letterSpacing = settings.letterSpacing + 'px';
            adjustFontSize();
        }

        // ==================== TEXT OPACITY ====================
        function updateTextOpacity() {
            settings.textOpacity = +document.getElementById('textOpacity').value;
            document.getElementById('textOpacityValue').textContent = settings.textOpacity + '%';
            mainText.style.opacity = settings.textOpacity / 100;
        }

        // ==================== PRESETS LIST ====================
        function applyPreset(preset) {
            const presets = {
                neon: { textColor: '#ffffff', bgColor: '#0b0c10', accentColor: '#ff00ff', effect: 'neon', bg: 'solid', fontFamily: "'Kanit', sans-serif" },
                minimal: { textColor: '#ffffff', bgColor: '#000000', accentColor: '#ffffff', effect: 'none', bg: 'solid', fontFamily: "'Sarabun', sans-serif" },
                gradient: { textColor: '#ff007f', bgColor: '#11001c', accentColor: '#ff7f00', effect: 'gradient', bg: 'gradient', fontFamily: "'Prompt', sans-serif" },
                dark: { textColor: '#1a1a2e', bgColor: '#ffffff', accentColor: '#000000', effect: 'outline', bg: 'solid', fontFamily: "'Kanit', sans-serif" },
                cyberpunk: { textColor: '#00ffff', bgColor: '#0f0c1b', accentColor: '#ff007f', effect: 'shadow', bg: 'cyberpunk', fontFamily: "'Mitr', sans-serif" },
                gold: { textColor: '#ffd700', bgColor: '#141414', accentColor: '#b8860b', effect: 'glow', bg: 'dots', fontFamily: "'Charm', cursive" },
                pastel: { textColor: '#ffb6c1', bgColor: '#faf5ff', accentColor: '#e0bbe4', effect: 'glow', bg: 'dots', fontFamily: "'Itim', cursive" },
                candy: { textColor: '#ff6b81', bgColor: '#fff5f5', accentColor: '#ffeaa7', effect: 'shadow', bg: 'solid', fontFamily: "'Mali', cursive" },
                vintage: { textColor: '#4a3728', bgColor: '#f4ecd8', accentColor: '#8b5a2b', effect: 'none', bg: 'lines', fontFamily: "'Noto Serif Thai', serif" },
                matrix: { textColor: '#00ff00', bgColor: '#020202', accentColor: '#003300', effect: 'glow', bg: 'matrix', fontFamily: "monospace" },
                fire: { textColor: '#ff3300', bgColor: '#0c0000', accentColor: '#ffcc00', effect: 'glow', bg: 'lines', fontFamily: "'Chonburi', serif" },
                sunset: { textColor: '#ffd1ff', bgColor: '#301934', accentColor: '#fad0c4', effect: 'gradient', bg: 'gradient', fontFamily: "'Kodchasan', sans-serif" }
            };

            const p = presets[preset];
            if (!p) return;

            settings.textColor = p.textColor;
            settings.bgColor = p.bgColor;
            settings.accentColor = p.accentColor;
            settings.effect = p.effect;
            settings.background = p.bg;
            settings.fontFamily = p.fontFamily;

            document.getElementById('textColor').value = p.textColor;
            document.getElementById('textColorHex').value = p.textColor;
            document.getElementById('bgColor').value = p.bgColor;
            document.getElementById('bgColorHex').value = p.bgColor;
            document.getElementById('accentColor').value = p.accentColor;
            document.getElementById('accentColorHex').value = p.accentColor;
            document.getElementById('fontFamily').value = p.fontFamily;

            document.documentElement.style.setProperty('--text-color', p.textColor);
            document.documentElement.style.setProperty('--bg-color', p.bgColor);
            document.documentElement.style.setProperty('--accent-color', p.accentColor);

            setEffect(p.effect);
            setBackground(p.bg);
            updateTextColor();
            updateBgColor();
            updateAccentColor();
            updateFontFamily();

            showToast(`🎨 เปิดใช้งานพรีเซ็ต "${preset}" แล้ว`);
        }

        // ==================== UI HELPERS ====================
        function updateActiveButton(group, value) {
            document.querySelectorAll(`[id^="${group}-"]`).forEach(btn => btn.classList.remove('active'));
            const btn = document.getElementById(`${group}-${value}`);
            if (btn) btn.classList.add('active');
        }

        // ==================== COPY TO CLIPBOARD ====================
        function copyToClipboard(text) {
            if (navigator.clipboard && window.isSecureContext) {
                return navigator.clipboard.writeText(text);
            }
            return new Promise((resolve, reject) => {
                const textarea = document.createElement('textarea');
                textarea.value = text;
                textarea.style.position = 'fixed';
                textarea.style.left = '-9999px';
                document.body.appendChild(textarea);
                textarea.focus();
                textarea.select();
                try {
                    const success = document.execCommand('copy');
                    document.body.removeChild(textarea);
                    if (success) resolve();
                    else reject(new Error('execCommand failed'));
                } catch (err) {
                    document.body.removeChild(textarea);
                    reject(err);
                }
            });
        }

        function exportSettings() {
            const json = JSON.stringify(settings, null, 2);
            copyToClipboard(json)
                .then(() => showToast('📋 คัดลอกการตั้งค่าเรียบร้อย!'))
                .catch(() => {
                    const blob = new Blob([json], { type: 'application/json' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'settings.json';
                    a.click();
                    URL.revokeObjectURL(url);
                    showToast('💾 บันทึกไฟล์ settings.json สำเร็จ!');
                });
        }

        function importSettings() {
            const json = prompt('กรุณาวาง JSON การตั้งค่าที่คัดลอกมา:');
            if (!json) return;
            try {
                const imported = JSON.parse(json);
                Object.assign(settings, imported);
                applyAllSettings();
                showToast('📥 นำเข้าการตั้งค่าสำเร็จแล้ว!');
            } catch (e) {
                alert('รูปแบบ JSON ไม่ถูกต้อง กรุณาลองใหม่อีกครั้ง');
            }
        }

        function resetSettings() {
            if (confirm('คุณต้องการรีเซ็ตค่าทั้งหมดกลับไปเป็นค่าเริ่มต้นใช่หรือไม่?')) {
                location.reload();
            }
        }

        function toggleFullscreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen();
            } else {
                document.exitFullscreen();
            }
        }

        // ==================== APPLY ALL SETTINGS ====================
        function applyAllSettings() {
            document.getElementById('textInput').value = settings.text;
            document.getElementById('autoFitToggle').checked = settings.autoFit;
            document.getElementById('minFontSize').value = settings.minFontSize || 40;
            document.getElementById('minFontSizeValue').textContent = (settings.minFontSize || 40) + 'px';
            document.getElementById('fontSize').value = settings.fontSize;
            document.getElementById('fontWeight').value = settings.fontWeight;
            document.getElementById('fontFamily').value = settings.fontFamily;
            document.getElementById('textColor').value = settings.textColor;
            document.getElementById('textColorHex').value = settings.textColor;
            document.getElementById('bgColor').value = settings.bgColor;
            document.getElementById('bgColorHex').value = settings.bgColor;
            document.getElementById('accentColor').value = settings.accentColor;
