        local TogCircle = Instance.new("Frame")
        TogCircle.Size = UDim2.new(0, 16, 0, 16)
        TogCircle.Position = UDim2.new(0, 2, 0.5, -8)
        TogCircle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        TogCircle.Parent = TogBox
        
        local CCorner = Instance.new("UICorner")
        CCorner.CornerRadius = UDim.new(0, 8)
        CCorner.Parent = TogCircle
                local Enabled = Default or false
        
        local function Update()
            if Enabled then
                TogBox.BackgroundColor3 = Config.ThemeColor
                TweenService:Create(TogCircle, TweenInfo.new(0.2), {Position = UDim2.new(0, 22, 0.5, -8)}):Play()
