                TweenService:Create(TogCircle, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -8)}):Play()
            end
            pcall(Callback, Enabled)
        end
        
        Update()
        
        TogBox.MouseButton1Click:Connect(function()
            Enabled = not Enabled
            Update()
        end)
        
        CurrentTab.CanvasSize = UDim2.new(0, 0, 0, PageList.AbsoluteContentSize.Y + 30)
    end

    -- // SLIDER
    function TabContent:CreateSlider(Name, Min, Max, Default, Callback)
        local SliFrame = Instance.new("Frame")
        SliFrame.Size = UDim2.new(0, 450, 0, 50)
        SliFrame.BackgroundTransparency = 1
        SliFrame.Parent = CurrentTab
        
        local SliLabel = Instance.new("TextLabel")
        SliLabel.Size = UDim2.new(1, 0, 0, 20)
        SliLabel.BackgroundTransparency = 1
        SliLabel.Text = Name .. ": " .. Default
        SliLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
        SliLabel.Font = Enum.Font.GothamMedium
        SliLabel.TextSize = 13
        SliLabel.TextXAlignment = Enum.TextXAlignment.Left
        SliLabel.Parent = SliFrame
        
        local SliBg = Instance.new("Frame")
        SliBg.Size = UDim2.new(1, -20, 0, 8)
        SliBg.Position = UDim2.new(0, 10, 0, 35)
        SliBg.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        SliBg.BorderSizePixel = 0
        SliBg.Parent = SliFrame
        
        local SCorner = Instance.new("UICorner")
        SCorner.CornerRadius = UDim.new(0, 4)
        SCorner.Parent = SliBg        
        local SliFill = Instance.new("Frame")
        SliFill.Size = UDim2.new((Default - Min) / (Max - Min), 0, 1, 0)
        SliFill.BackgroundColor3 = Config.ThemeColor
        SliFill.BorderSizePixel = 0
        SliFill.Parent = SliBg
        
        local FCorner = Instance.new("UICorner")
        FCorner.CornerRadius = UDim.new(0, 4)
        FCorner.Parent = SliFill
        
        local SliBtn = Instance.new("TextButton")
        SliBtn.Size = UDim2.new(0, 14, 0, 14)
        SliBtn.Position = UDim2.new((Default - Min) / (Max - Min), -7, 0.5, -7)
        SliBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        SliBtn.Text = ""
        SliBtn.AutoButtonColor = false
        SliBtn.Parent = SliBg
        
        local BCor = Instance.new("UICorner")
        BCor.CornerRadius = UDim.new(0, 7)
        BCor.Parent = SliBtn
        
        local Sliding = false
        
        local function UpdateSlider(Input)
            local Pos = math.clamp((Input.Position.X - SliBg.AbsolutePosition.X) / SliBg.AbsoluteSize.X, 0, 1)
            SliBtn.Position = UDim2.new(Pos, -7, 0.5, -7)
            SliFill.Size = UDim2.new(Pos, 0, 1, 0)
            
            local Value = math.floor(((Pos * (Max - Min)) + Min) * 10) / 10
            SliLabel.Text = Name .. ": " .. tostring(Value)
            pcall(Callback, Value)
        end
        
        SliBtn.MouseButton1Down:Connect(function() Sliding = true end)
        UserInputService.InputEnded:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 then Sliding = false end
        end)
        UserInputService.InputChanged:Connect(function(Input)
            if Sliding and Input.UserInputType == Enum.UserInputType.MouseMovement then UpdateSlider(Input) end
        end)
        
        CurrentTab.CanvasSize = UDim2.new(0, 0, 0, PageList.AbsoluteContentSize.Y + 30)
    end
    
    -- // DROPDOWN
    function TabContent:CreateDropdown(Name, Options, Callback)
        local DropFrame = Instance.new("Frame")
        DropFrame.Size = UDim2.new(0, 450, 0, 35)        DropFrame.BackgroundTransparency = 1
        DropFrame.Parent = CurrentTab
        
        local DropBtn = Instance.new("TextButton")
        DropBtn.Size = UDim2.new(1, 0, 1, 0)
        DropBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        DropBtn.Text = Name .. ": " .. Options[1]
        DropBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        DropBtn.Font = Enum.Font.GothamMedium
        DropBtn.TextSize = 13
        DropBtn.TextXAlignment = Enum.TextXAlignment.Left
        DropBtn.AutoButtonColor = false
        DropBtn.Parent = DropFrame
        
        local DCorner = Instance.new("UICorner")
        DCorner.CornerRadius = UDim.new(0, 6)
        DCorner.Parent = DropBtn
        
        local DArrow = Instance.new("ImageLabel")
        DArrow.Size = UDim2.new(0, 15, 0, 15)
        DArrow.Position = UDim2.new(1, -20, 0.5, -7)
        DArrow.Image = Icons.ArrowDown
        DArrow.BackgroundTransparency = 1
        DArrow.ImageColor3 = Color3.fromRGB(200, 200, 200)
        DArrow.Parent = DropBtn
        
        local ListFrame = Instance.new("ScrollingFrame")
        ListFrame.Size = UDim2.new(1, 0, 0, 0)
        ListFrame.Position = UDim2.new(0, 0, 1, 5)
        ListFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        ListFrame.BorderSizePixel = 0
        ListFrame.ScrollBarThickness = 0
        ListFrame.Visible = false
        ListFrame.ZIndex = 10
        ListFrame.Parent = DropFrame
        
        local LCorner = Instance.new("UICorner")
        LCorner.CornerRadius = UDim.new(0, 6)
        LCorner.Parent = ListFrame
        
        local LList = Instance.new("UIListLayout")
        LList.Parent = ListFrame
        
        local Opened = false
        
        for _, Option in pairs(Options) do
            local OptBtn = Instance.new("TextButton")
            OptBtn.Size = UDim2.new(1, 0, 0, 25)
            OptBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            OptBtn.Text = Option            OptBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
            OptBtn.Font = Enum.Font.GothamMedium
            OptBtn.TextSize = 12
            OptBtn.AutoButtonColor = false
            OptBtn.Parent = ListFrame
            
            OptBtn.MouseButton1Click:Connect(function()
                DropBtn.Text = Name .. ": " .. Option
                pcall(Callback, Option)
                Opened = false
                ListFrame.Visible = false
                DropFrame.Size = UDim2.new(0, 450, 0, 35)
            end)
            
            OptBtn.MouseEnter:Connect(function() OptBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50) end)
            OptBtn.MouseLeave:Connect(function() OptBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40) end)
        end
        
        ListFrame.CanvasSize = UDim2.new(0, 0, 0, LList.AbsoluteContentSize.Y)
        
        DropBtn.MouseButton1Click:Connect(function()
            Opened = not Opened
            ListFrame.Visible = Opened
            if Opened then
                DropFrame.Size = UDim2.new(0, 450, 0, 35 + ListFrame.CanvasSize.Y.Offset + 5)
                -- Re-update canvas of main page to fit dropdown
                CurrentTab.CanvasSize = UDim2.new(0, 0, 0, PageList.AbsoluteContentSize.Y + 100) 
            else
                DropFrame.Size = UDim2.new(0, 450, 0, 35)
                CurrentTab.CanvasSize = UDim2.new(0, 0, 0, PageList.AbsoluteContentSize.Y + 30)
            end
        end)
        
        CurrentTab.CanvasSize = UDim2.new(0, 0, 0, PageList.AbsoluteContentSize.Y + 30)
    end

    return TabContent
end

