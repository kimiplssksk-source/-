--// Create Tab
function Aether:CreateTab(name, icon)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Name = name
    tabBtn.Size = UDim2.new(1, -10, 0, 40)
    tabBtn.Position = UDim2.new(0, 5, 0, 10 + (#self.Tabs * 45))
    tabBtn.BackgroundColor3 = Aether.Theme.Surface
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = "  " .. (icon or "•") .. "  " .. name
    tabBtn.TextColor3 = Aether.Theme.TextDark
    tabBtn.TextSize = 14
    tabBtn.Font = Enum.Font.GothamSemibold
    tabBtn.TextXAlignment = Enum.TextXAlignment.Left
    tabBtn.Parent = self.Sidebar
    
    CreateCorner(tabBtn, UDim.new(0, 8))
    
    -- Tab Content
    local tabContent = Instance.new("ScrollingFrame")
    tabContent.Name = name .. "Content"
    tabContent.Size = UDim2.new(1, -20, 1, -20)
    tabContent.Position = UDim2.new(0, 10, 0, 10)
    tabContent.BackgroundTransparency = 1
    tabContent.ScrollBarThickness = 4
    tabContent.ScrollBarImageColor3 = Aether.Theme.Primary
    tabContent.Visible = false
    tabContent.Parent = self.Content
    
    local UIList = Instance.new("UIListLayout")
    UIList.Padding = UDim.new(0, 10)
    UIList.SortOrder = Enum.SortOrder.LayoutOrder
    UIList.Parent = tabContent
    
    -- Tab Logic
    tabBtn.MouseEnter:Connect(function()
        if self.CurrentTab ~= name then
            Tween(tabBtn, {BackgroundTransparency = 0.5, TextColor3 = Aether.Theme.Text}, 0.2)
        end
    end)
    
    tabBtn.MouseLeave:Connect(function()
        if self.CurrentTab ~= name then
            Tween(tabBtn, {BackgroundTransparency = 1, TextColor3 = Aether.Theme.TextDark}, 0.2)
        end
    end)
    
    tabBtn.MouseButton1Click:Connect(function()
        self:SwitchTab(name)
    end)
    
    self.Tabs[name] = {
        Button = tabBtn,
        Content = tabContent
    }
    
    if not self.CurrentTab then
        self:SwitchTab(name)
    end
    
    return tabContent
end

--// Switch Tab
function Aether:SwitchTab(name)
    for tabName, tabData in pairs(self.Tabs) do
        if tabName == name then
            self.CurrentTab = name
            tabData.Content.Visible = true
            Tween(tabData.Button, {BackgroundTransparency = 0.3, TextColor3 = Aether.Theme.Text}, 0.3)
            
            -- Gradient indicator
            local indicator = tabData.Button:FindFirstChild("Indicator")
            if not indicator then
                indicator = Instance.new("Frame")
                indicator.Name = "Indicator"
                indicator.Size = UDim2.new(0, 3, 0.6, 0)
                indicator.Position = UDim2.new(0, 0, 0.2, 0)
                indicator.BorderSizePixel = 0
                indicator.Parent = tabData.Button
                
                CreateGradient(indicator, {
                    ColorSequenceKeypoint.new(0, Aether.Theme.Primary),
                    ColorSequenceKeypoint.new(1, Aether.Theme.Secondary)
                }, 0)
                CreateCorner(indicator, UDim.new(0, 2))
            end
            indicator.Visible = true
            
            -- Content animation
            tabData.Content.Position = UDim2.new(0, 20, 0, 10)
            Tween(tabData.Content, {Position = UDim2.new(0, 10, 0, 10)}, 0.3)
        else
            tabData.Content.Visible = false
            Tween(tabData.Button, {BackgroundTransparency = 1, TextColor3 = Aether.Theme.TextDark}, 0.3)
            local indicator = tabData.Button:FindFirstChild("Indicator")
            if indicator then indicator.Visible = false end
        end
    end
end

--// Create Button (Gradient Style)
function Aether:CreateButton(parent, text, callback)
    local btn = Instance.new("TextButton")
    btn.Name = text
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.BackgroundColor3 = Aether.Theme.Surface
    btn.Text = text
    btn.TextColor3 = Aether.Theme.Text
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = parent
    
    CreateCorner(btn, UDim.new(0, 10))
    
    -- Gradient Background
    local gradient = CreateGradient(btn, {
        ColorSequenceKeypoint.new(0, Aether.Theme.Primary),
        ColorSequenceKeypoint.new(1, Aether.Theme.Secondary)
    }, 45, {0, 0.9, 1, 0.9}) -- โปร่งใสมาก
    
    local stroke = CreateStroke(btn, Aether.Theme.Primary, 1.5)
    
    btn.MouseEnter:Connect(function()
        Tween(btn, {BackgroundTransparency = 0.3}, 0.2)
        Tween(stroke, {Transparency = 0.3, Thickness = 2.5}, 0.2)
    end)
    
    btn.MouseLeave:Connect(function()
        Tween(btn, {BackgroundTransparency = 0}, 0.2)
        Tween(stroke, {Transparency = 0.8, Thickness = 1.5}, 0.2)
    end)
    
    btn.MouseButton1Click:Connect(function()
        Tween(btn, {Size = UDim2.new(0.95, 0, 0, 38)}, 0.1)
        wait(0.1)
        Tween(btn, {Size = UDim2.new(1, 0, 0, 40)}, 0.1)
        if callback then callback() end
    end)
    
    return btn
end

--// Create Toggle (Neon Switch)
function Aether:CreateToggle(parent, text, default, callback)
    local container = Instance.new("Frame")
    container.Name = text .. "Toggle"
    container.Size = UDim2.new(1, 0, 0, 40)
    container.BackgroundColor3 = Aether.Theme.Surface
    container.BackgroundTransparency = 0.5
    container.Parent = parent
    
    CreateCorner(container, UDim.new(0, 10))
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.Position = UDim2.new(0, 15, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Aether.Theme.Text
    label.TextSize = 14
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container
    
    -- Toggle Switch
    local switch = Instance.new("Frame")
    switch.Name = "Switch"
    switch.Size = UDim2.new(0, 44, 0, 24)
    switch.Position = UDim2.new(1, -60, 0.5, -12)
    switch.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    switch.Parent = container
    
    CreateCorner(switch, UDim.new(0, 12))
    
    local circle = Instance.new("Frame")
    circle.Name = "Circle"
    circle.Size = UDim2.new(0, 18, 0, 18)
    circle.Position = UDim2.new(0, 3, 0.5, -9)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.Parent = switch
    
    CreateCorner(circle, UDim.new(1, 0))
    
    local enabled = default or false
    
    local function UpdateToggle()
        if enabled then
            Tween(switch, {BackgroundColor3 = Aether.Theme.Primary}, 0.3)
            Tween(circle, {Position = UDim2.new(0, 23, 0.5, -9)}, 0.3)
            -- Glow effect
            local glow = switch:FindFirstChild("Glow")
            if not glow then
                glow = Instance.new("ImageLabel")
                glow.Name = "Glow"
                glow.Size = UDim2.new(1, 20, 1, 20)
                glow.Position = UDim2.new(0, -10, 0, -10)
                glow.BackgroundTransparency = 1
                glow.Image = "rbxassetid://131604521937076"
                glow.ImageColor3 = Aether.Theme.Primary
                glow.ImageTransparency = 0.8
                glow.Parent = switch
            end
            Tween(glow, {ImageTransparency = 0.5}, 0.3)
        else
            Tween(switch, {BackgroundColor3 = Color3.fromRGB(60, 60, 70)}, 0.3)
            Tween(circle, {Position = UDim2.new(0, 3, 0.5, -9)}, 0.3)
            local glow = switch:FindFirstChild("Glow")
            if glow then Tween(glow, {ImageTransparency = 1}, 0.3) end
        end
        if callback then callback(enabled) end
    end
    
    -- Click area
    local clickArea = Instance.new("TextButton")
    clickArea.Size = UDim2.new(1, 0, 1, 0)
    clickArea.BackgroundTransparency = 1
    clickArea.Text = ""
    clickArea.Parent = container
    
    clickArea.MouseButton1Click:Connect(function()
        enabled = not enabled
        UpdateToggle()
    end)
    
    if enabled then UpdateToggle() end
    
    return container
end

--// Create Slider (Gradient Track)
function Aether:CreateSlider(parent, text, min, max, default, callback)
    local container = Instance.new("Frame")
    container.Name = text .. "Slider"
    container.Size = UDim2.new(1, 0, 0, 60)
    container.BackgroundColor3 = Aether.Theme.Surface
    container.BackgroundTransparency = 0.5
    container.Parent = parent
    
    CreateCorner(container, UDim.new(0, 10))
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.6, 0, 0, 20)
    label.Position = UDim2.new(0, 15, 0, 8)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Aether.Theme.Text
    label.TextSize = 14
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container
    
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0.3, 0, 0, 20)
    valueLabel.Position = UDim2.new(0.7, -10, 0, 8)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(default or min)
    valueLabel.TextColor3 = Aether.Theme.Secondary
    valueLabel.TextSize = 14
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = container
    
    -- Track
    local track = Instance.new("Frame")
    track.Name = "Track"
    track.Size = UDim2.new(1, -30, 0, 6)
    track.Position = UDim2.new(0, 15, 0, 38)
    track.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    track.BorderSizePixel = 0
    track.Parent = container
    
    CreateCorner(track, UDim.new(0, 3))
    
    -- Fill (Gradient)
    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Aether.Theme.Primary
    fill.BorderSizePixel = 0
    fill.Parent = track
    
    CreateGradient(fill, {
        ColorSequenceKeypoint.new(0, Aether.Theme.Primary),
        ColorSequenceKeypoint.new(1, Aether.Theme.Secondary)
    }, 0)
    CreateCorner(fill, UDim.new(0, 3))
    
    -- Thumb
    local thumb = Instance.new("Frame")
    thumb.Name = "Thumb"
    thumb.Size = UDim2.new(0, 16, 0, 16)
    thumb.Position = UDim2.new((default - min) / (max - min), -8, 0.5, -8)
    thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    thumb.BorderSizePixel = 0
    thumb.Parent = track
    
    CreateCorner(thumb, UDim.new(1, 0))
    CreateStroke(thumb, Aether.Theme.Primary, 2)
    
    -- Glow
    local glow = Instance.new("ImageLabel")
    glow.Name = "Glow"
    glow.Size = UDim2.new(1, 10, 1, 10)
    glow.Position = UDim2.new(0, -5, 0, -5)
    glow.BackgroundTransparency = 1
    glow.Image = "rbxassetid://131604521937076"
    glow.ImageColor3 = Aether.Theme.Primary
    glow.ImageTransparency = 0.7
    glow.Parent = thumb
    
    -- Slider Logic
    local dragging = false
    local currentValue = default or min
    
    local function UpdateSlider(input)
        local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        currentValue = math.floor(min + (pos * (max - min)))
        valueLabel.Text = tostring(currentValue)
        Tween(fill, {Size = UDim2.new(pos, 0, 1, 0)}, 0.1)
        Tween(thumb, {Position = UDim2.new(pos, -8, 0.5, -8)}, 0.1)
        if callback then callback(currentValue) end
    end
    
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateSlider(input)
        end
    end)
    
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateSlider(input)
        end
    end)
    
    game:GetService("UserInputService").InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    return container
end

