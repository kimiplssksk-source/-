        optBtn.BackgroundColor3 = Aether.Theme.Surface
        optBtn.BackgroundTransparency = 1
        optBtn.Text = option
        optBtn.TextColor3 = Aether.Theme.TextDark
        optBtn.TextSize = 13
        optBtn.Font = Enum.Font.Gotham
        optBtn.Parent = optionsFrame
        
        optBtn.MouseEnter:Connect(function()
            Tween(optBtn, {BackgroundTransparency = 0.5, TextColor3 = Aether.Theme.Text}, 0.2)
        end)
        optBtn.MouseLeave:Connect(function()
            Tween(optBtn, {BackgroundTransparency = 1, TextColor3 = Aether.Theme.TextDark}, 0.2)
        end)
        optBtn.MouseButton1Click:Connect(function()
            selected.Text = option
            expanded = false
            Tween(container, {Size = UDim2.new(1, 0, 0, 40)}, 0.3)
            Tween(arrow, {Rotation = 0}, 0.3)
            optionsFrame.Visible = false
            if callback then callback(option) end
        end)
    end
    
    clickArea.MouseButton1Click:Connect(function()
        expanded = not expanded
        if expanded then
            optionsFrame.Visible = true
            local totalHeight = math.min(#options * optionHeight, 150)
            Tween(container, {Size = UDim2.new(1, 0, 0, 40 + totalHeight)}, 0.3)
            Tween(arrow, {Rotation = 180}, 0.3)
        else
            Tween(container, {Size = UDim2.new(1, 0, 0, 40)}, 0.3)
            Tween(arrow, {Rotation = 0}, 0.3)
            wait(0.3)
            optionsFrame.Visible = false
        end
    end)
    
    return container
end

--// Create Label (Gradient Text)
function Aether:CreateLabel(parent, text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 30)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Aether.Theme.Text
    label.TextSize = 16
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = parent
    
    return label
end

--// Create Section Divider (Gradient Line)
function Aether:CreateDivider(parent, title)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 30)
    container.BackgroundTransparency = 1
    container.Parent = parent
    
    if title then
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0, 100, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = title
        label.TextColor3 = Aether.Theme.TextDark
        label.TextSize = 12
        label.Font = Enum.Font.Gotham
        label.Parent = container
    end
    
    local line = Instance.new("Frame")
    line.Size = UDim2.new(1, 0, 0, 2)
    line.Position = UDim2.new(0, 0, 0.5, 0)
    line.BorderSizePixel = 0
    line.Parent = container
    
    CreateGradient(line, {
        ColorSequenceKeypoint.new(0, Aether.Theme.Primary),
        ColorSequenceKeypoint.new(0.5, Aether.Theme.Secondary),
        ColorSequenceKeypoint.new(1, Aether.Theme.Accent)
    }, 0)
    
    return container
end

--// Keybind System
function Aether:SetKeybind(key, callback)
    game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == key then
            callback()
        end
    end)
end

--// Notification System (Toast)
function Aether:Notify(title, message, duration)
    duration = duration or 3
    
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 280, 0, 80)
    notif.Position = UDim2.new(1, 300, 1, -100)
    notif.BackgroundColor3 = Aether.Theme.Surface
    notif.BackgroundTransparency = 0.1
    notif.BorderSizePixel = 0
    notif.Parent = playerGui:FindFirstChild("AetherHub") or playerGui
    
    CreateCorner(notif, UDim.new(0, 12))
    CreateStroke(notif, Aether.Theme.Primary, 1.5)
    
    local gradientLine = Instance.new("Frame")
    gradientLine.Size = UDim2.new(1, 0, 0, 3)
    gradientLine.Position = UDim2.new(0, 0, 0, 0)
    gradientLine.BorderSizePixel = 0
    gradientLine.Parent = notif
    
    CreateGradient(gradientLine, {
        ColorSequenceKeypoint.new(0, Aether.Theme.Primary),
        ColorSequenceKeypoint.new(1, Aether.Theme.Secondary)
    }, 0)
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -20, 0, 25)
    titleLabel.Position = UDim2.new(0, 10, 0, 10)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.TextColor3 = Aether.Theme.Text
    titleLabel.TextSize = 16
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.Parent = notif
    
    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, -20, 0, 40)
    msgLabel.Position = UDim2.new(0, 10, 0, 35)
    msgLabel.BackgroundTransparency = 1
    msgLabel.Text = message
    msgLabel.TextColor3 = Aether.Theme.TextDark
    msgLabel.TextSize = 13
    msgLabel.Font = Enum.Font.Gotham
    msgLabel.TextWrapped = true
    msgLabel.Parent = notif
    
    -- Animate in
    Tween(notif, {Position = UDim2.new(1, -300, 1, -100)}, 0.5)
    
    wait(duration)
    
    -- Animate out
    Tween(notif, {Position = UDim2.new(1, 300, 1, -100)}, 0.5)
    wait(0.5)
    notif:Destroy()
end

--// Return Library
return Aether
