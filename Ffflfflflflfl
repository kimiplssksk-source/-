--// Utility Functions
local function CreateGradient(parent, colorPoints, rotation, transparency)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new(colorPoints)
    gradient.Rotation = rotation or 45
    if transparency then
        gradient.Transparency = NumberSequence.new(transparency)
    end
    gradient.Parent = parent
    return gradient
end

local function CreateStroke(parent, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Aether.Theme.Border
    stroke.Thickness = thickness or Aether.Settings.StrokeThickness
    stroke.Transparency = 0.8
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = parent
    return stroke
end

local function CreateCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = radius or Aether.Settings.CornerRadius
    corner.Parent = parent
    return corner
end

local function CreateShadow(parent)
    local shadow = Instance.new("ImageLabel")
    shadow.Name = "Shadow"
    shadow.BackgroundTransparency = 1
    shadow.Image = "rbxassetid://131604521937076" -- หรือใช้ Shadow ของคุณเอง
    shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
    shadow.ImageTransparency = 0.6
    shadow.ScaleType = Enum.ScaleType.Slice
    shadow.SliceCenter = Rect.new(10, 10, 118, 118)
    shadow.Size = UDim2.new(1, 20, 1, 20)
    shadow.Position = UDim2.new(0, -10, 0, -10)
    shadow.ZIndex = parent.ZIndex - 1
    shadow.Parent = parent
    return shadow
end

local function Tween(obj, properties, duration, delay)
    local tween = TweenService:Create(obj, TweenInfo.new(
        duration or Aether.Settings.AnimationSpeed,
        Aether.Settings.EasingStyle,
        Aether.Settings.EasingDirection,
        0, false, delay or 0
    ), properties)
    tween:Play()
    return tween
end

